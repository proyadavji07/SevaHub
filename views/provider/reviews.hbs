<div class="container mt-4">
  <h3 class="mb-4 text-center"> Customer Reviews</h3>

  {{#if reviews.length}}
    <div class="row">
      {{#each reviews}}
        <div class="col-md-6 mb-4">
          <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body">
              <h5 class="card-title text-primary">
                {{orderId.service}} (Order ID: {{orderId._id}})
              </h5>
              <p class="card-text mb-1"><strong>Customer:</strong> {{orderId.customer.name}}</p>
              <p class="card-text mb-1"><strong>Rating:</strong>  {{rating}}</p>
              <p class="card-text"><strong>Comment:</strong> {{comment}}</p>
              <small class="text-muted">Reviewed on {{formatDate createdAt}}</small>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="text-center mt-5">
      <h5>No reviews yet </h5>
    </div>
  {{/if}}
</div>