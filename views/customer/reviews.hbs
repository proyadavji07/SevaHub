<div class="container mt-4">
  <h3 class="mb-4 text-center"> My Reviews</h3>

  {{#if reviews.length}}
    <div class="row">
      {{#each reviews}}
        <div class="col-md-6 mb-4">
          <div class="card shadow-sm border-0">
            <div class="card-body">
              <h5 class="text-primary">Order ID: {{this.orderId._id}}</h5>
              <p><strong>Rating:</strong> {{this.rating}}</p>
              <p><strong>Feedback:</strong> {{this.comment}}</p>
              <small class="text-muted">Reviewed on {{formatDate this.createdAt}}</small>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <p class="text-center mt-5">No reviews yet </p>
  {{/if}}
</div>