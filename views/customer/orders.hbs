<div class="container mt-4">
  <h3 class="mb-4 text-center"> My Orders</h3>

  {{#if orders.length}}
    <div class="row">
      {{#each orders}}
        <div class="col-md-6 mb-4">
          <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body">
              <h5 class="card-title text-primary">{{this.service}}</h5>
              <p class="card-text mb-1"><strong>Provider:</strong> {{this.serviceProvider.name}}</p>
              <p class="card-text mb-1"><strong>Total:</strong> ₹{{this.totalAmount}}</p>
              <p class="card-text mb-1"><strong>Status:</strong> 
                <span class="badge 
                  {{#if (eq this.status 'accepted')}}bg-success{{else if (eq this.status 'pending')}}bg-warning{{else}}bg-secondary{{/if}}">
                  {{this.status}}
                </span>
              </p>
              <p class="card-text"><strong>Payment:</strong> {{this.paymentStatus}}</p>
              <p class="card-text mb-1"><strong>Order ID:</strong> {{this._id}}</p>
              <small class="text-muted">Ordered on {{formatDate this.createdAt}}</small>

              <!-- Review Button -->
              <div class="mt-3">
                {{#if (eq this.paymentStatus 'unpaid')}}
                  <a href="/customer/payments/{{this._id}}" class="btn btn-sm btn-primary">Continue Payment</a>
                {{/if}}
                <a href="/customer/reviews/add/{{this._id}}" class="btn btn-outline-primary btn-sm">
                   Write Review
                </a>
              </div>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="text-center mt-5">
      <h5>No orders yet </h5>
      <a href="/" class="btn btn-primary mt-3">Book a Service</a>
    </div>
  {{/if}}
</div>
