<div class="container text-center mt-5">
  <div class="card shadow p-4">
    <h2 class="text-success"> Payment Successful!</h2>
    <p class="mt-3">
      Thank you, {{order.customer.name}}! Your booking for
      <strong>{{order.service}}</strong> with
      <strong>{{order.serviceProvider.name}}</strong> has been confirmed.
    </p>

    <h4 class="mt-3">Total Paid: ₹{{order.totalAmount}}</h4>
    <h5>Payment Method: {{order.paymentMethod}}</h5>

    <a href="/customer/orders" class="btn btn-primary mt-4">View My Orders</a>
  </div>
</div>