{{!-- views/home.hbs --}}

<div class="container-fluid hero">
  <div class="hero-content text-center">
    <h1 class="display-4 mb-4 f">Welcome to Our Service Platform</h1>
    <p class="lead">Your One-Stop Solution for Trusted Home Services</p>
  </div>

  {{#if user}}
  {{#if (eq user.role "service_provider")}}
    <h3>Service Provider Dashboard</h3>
    <p>Manage your services and bookings.</p>
    <a href="/provider/dashboard" class="btn btn-success btn-lg">Go to Dashboard</a>
  {{else}}
    {{> hero-services }}
  {{/if}}
{{else}}
  {{> hero-services }}
{{/if}}
</div>

<style>
  .sidebar {
      position: sticky;
      top: 20px;
    }
  .stats div h3 {
  font-weight: bold;
  color: #333;
}

.stats small {
  color: #666;
}

.stats img {
  margin-right: 6px;
  vertical-align: middle;
}

    .service-section {
      padding: 60px 20px;
    }
  .sidebar h1 { font-size: 2rem; font-weight: bold; color: #333; }
    .sidebar h5 { color: #333 }
    .service-box {
      background: linear-gradient(135deg, transparent, grey);
      padding: 15px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      transition: all 0.3s ease;
    }
    .service-box img { width: 50px; margin-bottom: 10px; }
    .service-box p { font-size: 0.95rem; color: #444; }
    .service-box:hover { transform: translateY(-5px); box-shadow: 0 6px 16px rgba(0,0,0,0.1);}
    .stats { display: flex; gap: 40px; }
    .stats h3 { font-weight: bold; color: #111; }
    .stats small { color: #777; }
    .grid-img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 12px;
    }

    /* Service card for sections */
    .service-card {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(0,0,0,0.09);
      height: 340px;
      background: transparent;
      margin-bottom: 24px;
      transition: all 0.3s ease;
    }
    .service-cards .card {
      margin-bottom: 15px;
    }
    .service-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .3s;
    }
    .service-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 18px 0;
      background: linear-gradient(0deg,rgba(0,0,0,0.62) 62%,rgba(0,0,0,0.05) 88%);
      color: #fff;
      font-size: 1.3rem;
      font-weight: 500;
      text-align: center;
      letter-spacing: 0.02em;
      transition: background .3s;
    }
    .service-card:hover {
      box-shadow: 0 6px 16px rgba(0,0,0,0.13);
      transform: translateY(-10px) scale(1.04);
    }
    .service-card:hover img {
      transform: scale(1.08);
    }
    .service-card:hover .service-overlay {
      background: linear-gradient(0deg,rgba(0,0,0,0.82) 70%,rgba(0,0,0,0.15) 90%);
    }

    .service-card {
      background: linear-gradient(135deg, transparent, grey);
    }
    /* Horizontal carousel for Home Repair cards */
    .card-carousel {
      display: flex;
      gap: 24px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 12px;
    }
    .card-carousel::-webkit-scrollbar { display: none; }
    .service-card-carousel {
      background: #fff;
      border: none;
      border-radius: 18px;
      min-width: 225px;
      max-width: 230px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.06);
      scroll-snap-align: start;
      position: relative;
      transition: box-shadow .2s, transform .2s;
    }
    .service-card-carousel:hover {
      box-shadow: 0 7px 22px rgba(0,0,0,0.13);
      transform: scale(1.04);
    }
    .card-img-top {
      height: 175px;
      width: 100%;
      object-fit: cover;
      border-radius: 18px 18px 0 0;
      background: #eee;
    }
    .service-content {
      padding: 16px 14px 18px 14px;
    }
    .service-title {
      font-size: 1.11rem;
      font-weight: 600;
      margin-bottom: 9px;
      text-align: left;
    }
    .service-rating {
      font-size: 1.03rem;
      color: #3e7bfa;
      font-weight: 600;
    }
    .service-reviews {
      font-size: 0.97rem;
      color: #888;
      margin-left: 6px;
    }
    @media (max-width: 650px) {
      .service-card, .service-card-carousel { height: 220px; }
      .grid-img { height: 120px; }
      .service-overlay { font-size: 1rem; padding: 10px 0;}
    }
    </style>