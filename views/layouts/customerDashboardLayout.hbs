<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="icon" type="image/png" href="/images/logo_v3.png">
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;700&display=swap" rel="stylesheet">
  <title>Customer Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>

  <style>
    * {
      font-family: 'Raleway', 'Quicksand', sans-serif !important;
    }

    body {
      background: #f9f9f9;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    /* --- Fix gap and layout --- */
    main {
      margin-top: 70px; /* same height as navbar */
      display: flex;
      min-height: calc(100vh - 70px);
    }

  .form-control {
    background: url('https://coolbackgrounds.imgix.net/5GbV8Si50TKkaulnxGwBa/f52a3d7e4d095c0ced0679c79f7d12f6/white-trianglify.jpg') no-repeat -50px;
  }

  .form-control:focus {
    box-shadow: none !important;
    border-color: #000000 !important;
    outline: none !important;
  }
    /* --- Sidebar --- */
    .sidebar {
      position: sticky; /* key change (not fixed) */
      top: 70px; /* keeps below navbar */
      align-self: flex-start;
      height: calc(100vh - 70px);
      background: #212529;
      color: white;
      padding-top: 20px;
      width: 230px;
      flex-shrink: 0;
      overflow-y: auto;
    }

    .sidebar h4 {
      text-align: center;
      margin-bottom: 20px;
    }

    .sidebar a {
      color: #ddd;
      text-decoration: none;
      display: block;
      padding: 10px 20px;
      transition: 0.2s ease-in-out;
    }

    .sidebar a:hover,
    .sidebar a.active {
      background: #6c757d;
      color: #fff;
      border-radius: 4px;
    }

    /* --- Main content --- */
    .main-content {
      flex: 1;
      padding: 30px;
      overflow-y: auto;
    }

    /* --- Responsive adjustments --- */
    @media (max-width: 992px) {
      main {
        flex-direction: column;
      }
      .sidebar {
        position: relative;
        top: 0;
        width: 100%;
        height: auto;
      }
      .main-content {
        margin-left: 0;
      }
    }
  </style>
</head>
<body>
  {{> header}}

  <main>
    <!-- Sidebar -->
    <div class="sidebar">
      <h4>Customer</h4>
      <a href="/customer/dashboard" class="{{#if (eq active 'dashboard')}}active{{/if}}">Dashboard</a>
      <a href="/customer/profile" class="{{#if (eq active 'profile')}}active{{/if}}">Profile</a>
      <a href="/customer/cart" class="{{#if (eq active 'cart')}}active{{/if}}">My Cart</a>
      <a href="/customer/orders" class="{{#if (eq active 'orders')}}active{{/if}}">My Orders</a>
      <a href="/customer/reviews" class="{{#if (eq active 'reviews')}}active{{/if}}">Reviews</a>
    </div>

    <!-- Main Content -->
    <div class="main-content">
      {{{body}}}
    </div>
  </main>

  {{> footer}}

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
  {{#if message}}
    Swal.fire({
      icon: '{{message.type}}',
      title: '{{message.text}}',
      timer: 2000,
      showConfirmButton: false
    })
  {{/if}}
  </script>
</body>
</html>