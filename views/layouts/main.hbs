<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SevaHub - Your Service Partner</title>
  <link rel="icon" type="image/png" href="/images/logo_v3.png">
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    /* ---- Global setup ---- */
    * { font-family: 'Raleway', sans-serif !important; }
    *:focus { outline: none !important; box-shadow: none !important; }

    body {
      margin: 0; padding: 0; min-height: 100vh;
      background: url('https://coolbackgrounds.imgix.net/5GbV8Si50TKkaulnxGwBa/f52a3d7e4d095c0ced0679c79f7d12f6/white-trianglify.jpg?w=3840&q=60&auto=format,compress') 
      center/cover no-repeat fixed;
    }

    :root {
      --accent: #393E46;
      --accent-600: #000;
      --text-muted: #8c8c8c;
    }

    /* ---- Form elements ---- */
    .form-selects, .form-controls {
      border: none; border-bottom: 1px solid #ddd; background: transparent; box-shadow: none !important;
      height: 48px; padding: 10px;
    }
    .form-selects:focus, .form-controls:focus { border-bottom-color: var(--accent); }

    /* ---- Layout ---- */
    .auth-wrapper { margin: 40px; border-radius: 20px; box-shadow: #777 0 0 15px -5px; }
    .auth-left { padding: 48px 40px; }
    .auth-title { font-weight: 700; font-size: 35px; margin-bottom: 18px; }
    .underline { width: 42px; height: 3px; background: var(--accent); border-radius: 2px; margin-top: 6px; }

    /* ---- Buttons & links ---- */
    .btn-accent1 { background: var(--accent); border: none; height: 48px; border-radius: 10px; width: 90%; font-weight: 600; }
    .btn-accent1:hover { background: var(--accent-600); }
    .link-muted, .small-text a { color: var(--accent); text-decoration: none; }
    .link-muted:hover, .small-text a:hover { color: var(--accent-600); }

    /* ---- Right visual ---- */
    .auth-right {
      background: linear-gradient(0deg,#000,rgba(55,56,58,0.65)), url('https://img.freepik.com/free-vector/geometric-gradient-futuristic-background_23-2149116406.jpg') center/cover no-repeat;
      color:#fff; display:flex; align-items:center; justify-content:center; padding:40px; border-radius:0 10px 10px 0;
    }

    @media (max-width: 767.98px){
      .auth-right{ min-height:220px; text-align:center; }
    }
  </style>
</head>

<body>
  {{> header}}

  <main>
    <br><br><br>
    {{{body}}}
    <br><br><br>
  </main>

  {{> footer}}

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="http://localhost:35729/livereload.js"></script>

  <!-- Location fetch -->
  <script>
    fetch('https://ipapi.co/json')
      .then(res => res.json())
      .then(data => document.getElementById('locationName').innerText = data.city + ', ' + data.region)
      .catch(() => document.getElementById('locationName').innerText = 'Location unavailable');
  </script>
</body>
</html>
