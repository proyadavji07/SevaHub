<style>
  .dropdown-menu .dropdown-item:active {
    background-color: #000 !important;
    color: #fff !important;
  }

  .navbar .form-control {
    background: url('https://coolbackgrounds.imgix.net/5GbV8Si50TKkaulnxGwBa/f52a3d7e4d095c0ced0679c79f7d12f6/white-trianglify.jpg') no-repeat -50px;
  }

  .navbar .form-control:focus {
    border-color: #000000 !important;
    outline: none !important;
  }

  .navbar-hidden {
    transform: translateY(-100%);
    transition: transform 0.5s ease-in-out;
  }

  /* 🔍 Search Suggestion Box */
  #suggestion-box {
    position: absolute;
    background: white;
    border: 1px solid #ddd;
    width: 100%;
    max-height: 180px;
    overflow-y: auto;
    z-index: 1050;
    display: none;
    border-radius: 6px;
  }

  #suggestion-box div {
    padding: 8px 12px;
    cursor: pointer;
  }

  #suggestion-box div:hover {
    background-color: #f2f2f2;
  }
</style>

<!-- 🌟 Top Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm px-3 py-2 align-items-center fixed-top">
  <!-- Logo -->
  <a class="navbar-brand fw-bold d-flex align-items-center me-3" href="/">
    <div class="me-2 bg-dark text-white px-2 py-1 rounded"><b>SH</b></div>
    <span><b>Seva</b>Hub</span>
  </a>

  <div class="flex-grow-1"></div>

  <!-- 🌍 Location -->
  <div class="d-flex align-items-center text-muted me-3" id="locationBox">
    <i class="bi bi-geo-alt-fill me-1"></i>
    <span id="location-text" class="location-text">Detecting...</span>
  </div>

  
  <!-- 🔍 Search (Desktop) -->
  {{#unless (eq user.role "service_provider")}}
  <div class="position-relative me-3 d-none d-md-block" style="width: 300px;">
    <input id="searchBox" type="search" class="form-control" placeholder="Search services..." autocomplete="off"/>
    <div id="suggestion-box"></div>
  </div>
  {{/unless}}


  <!-- 👤 Account Dropdown -->
<div class="dropdown d-none d-lg-block">
  {{#if user}}
    <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" id="navbarUserDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
      <img src="{{user.image}}" alt="Profile" class="rounded-circle me-2 shadow-sm" width="36" height="36" style="object-fit:cover;">
      <span class="fw-semibold">{{user.name}}</span>
    </a>

    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="navbarUserDropdown">
      {{#if (eq user.role "customer")}}
        <li><a class="dropdown-item" href="/customer/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
        <li><a class="dropdown-item" href="/customer/profile"><i class="bi bi-person-lines-fill me-2"></i>Profile</a></li>
      {{else if (eq user.role "service_provider")}}
        <li><a class="dropdown-item" href="/provider/dashboard"><i class="bi bi-briefcase-fill me-2"></i>Dashboard</a></li>
        <li><a class="dropdown-item" href="/provider/profile"><i class="bi bi-person-lines-fill me-2"></i>Profile</a></li>
      {{/if}}
      <li><hr class="dropdown-divider"></li>
      <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
    </ul>
  {{else}}
    <!-- Default if not logged in -->
    <a href="#" class="btn btn-outline-dark dropdown-toggle" data-bs-toggle="dropdown">
      <i class="bi bi-person-fill"></i> Account
    </a>
    <ul class="dropdown-menu dropdown-menu-end">
      <li><a class="dropdown-item" href="/login"><i class="bi bi-box-arrow-in-right me-2"></i>Login</a></li>
      <li><a class="dropdown-item" href="/reg-phone"><i class="bi bi-person-plus me-2"></i>Register</a></li>
    </ul>
  {{/if}}
</div>

</nav>
<!-- 🧭 Scripts -->
<script>
  // 🌍 Location Fetch
  document.addEventListener("DOMContentLoaded", () => {
    const locationSpan = document.getElementById("location-text");
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(async (position) => {
        const { latitude, longitude } = position.coords;
        try {
          const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}`);
          const data = await res.json();
          const city = data.address.city || data.address.town || data.address.village || 'Your Area';
          const state = data.address.state || '';
          locationSpan.textContent = `${city}, ${state}`;
        } catch (err) {
          locationSpan.textContent = "Location unavailable";
        }
      }, () => {
        locationSpan.textContent = "Location blocked";
      });
    } else {
      locationSpan.textContent = "Geolocation not supported";
    }
  });

  // 🧭 Hide / Show Navbar on scroll
  let lastScrollTop = 0;
  const navbar = document.querySelector(".navbar");
  window.addEventListener("scroll", function () {
    let scrollTop = window.scrollY;
    if (scrollTop > lastScrollTop) {
      navbar.classList.add("navbar-hidden");
    } else {
      navbar.classList.remove("navbar-hidden");
    }
    lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
  });
</script>
<script>
const searchBox = document.getElementById("searchBox");
const suggestionBox = document.getElementById("suggestion-box");
let debounceTimer;

searchBox.addEventListener("input", () => {
  const query = searchBox.value.trim();
  clearTimeout(debounceTimer);

  if (query.length < 2) {
    suggestionBox.style.display = "none";
    return;
  }

  debounceTimer = setTimeout(async () => {
    try {
      const res = await fetch(`/search-services?q=${encodeURIComponent(query)}`);
      const data = await res.json();
      showSuggestions(data);
    } catch (err) {
      console.error("Search failed:", err);
    }
  }, 300);
});

function showSuggestions(results) {
  suggestionBox.innerHTML = "";

  if (!results || results.length === 0) {
    suggestionBox.style.display = "none";
    return;
  }

  results.forEach(item => {
    const div = document.createElement("div");

    if (item.noResult) {
      div.innerHTML = `<span class="text-danger">${item.message}</span>`;
      div.style.cursor = "default";
    } else {
      div.innerHTML = `
        <b>${item.service}</b>
        <small class="text-muted"> by ${item.provider}</small>
        <span class="float-end text-success fw-semibold">₹${item.price}</span>
      `;
      div.addEventListener("click", () => {
        window.location.href = "/services/" + encodeURIComponent(item.service.toLowerCase());
      });
    }

    suggestionBox.appendChild(div);
  });

  suggestionBox.style.display = "block";
}

document.addEventListener("click", (e) => {
  if (!searchBox.contains(e.target) && !suggestionBox.contains(e.target)) {
    suggestionBox.style.display = "none";
  }
});
</script>