<div class="auth-wrapper">
  <div class="col-md-6 auth-left">
    <h2 class="auth-title">Forgot Password</h2>
    <div class="underline"></div>

    {{#if error}}
      <div class="alert alert-danger">{{error}}</div>
    {{/if}}
    {{#if success}}
      <div class="alert alert-success">{{success}}</div>
    {{/if}}

    <form action="/forgot-password" method="POST" class="mt-4">
      <div class="m-3 position-relative">
        <i class="bi bi-envelope-fill input-icon"></i>
        <input type="email" name="email" class="form-controls" placeholder="Enter your registered email" required>
      </div>

      <button type="submit" class="btn-accent1 btn-primary mt-3 m-3 text-white">Send Reset OTP</button>

      <p class="small-text mt-4 mb-0">
        <a href="/login" class="link-muted">Back to login</a>
      </p>
    </form>
  </div>
</div>